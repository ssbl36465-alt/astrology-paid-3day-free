rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /gurus/{guruId} {
      allow read: if true;
      allow write: if true;
    }
    match /guru_applications/{appId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /client_bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }
    match /client_recharges/{rechargeId} {
      allow read: if true;
      allow write: if true;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    match /test/connection {
      allow read: if true;
    }
  }
}
